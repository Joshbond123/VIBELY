# Imported by /system/etc/init/hw/init.rc via `import /init.${ro.hardware}.rc`.
# The stock emulator ramdisk has no such file; root-live.py ships it through
# Magisk's overlay.d, which magiskinit copies into the rootfs before init runs.
# This is the only reliable way to execute code as root on a Play-store AVD
# (adb root is refused, the manager app's setup needs a boot partition).

# Probe: if this property is set, init parsed us (verifiable from adb shell).
on init
    setprop vibely.rc.parsed 1

service vibely-boot-hook /system/bin/sh /vibely-boot-hook.sh
    class late_start
    user root
    group root system
    oneshot

on property:sys.boot_completed=1
    start vibely-boot-hook
