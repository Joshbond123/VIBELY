# Imported by /system/etc/init/hw/init.rc via `import /init.${ro.hardware}.rc`.
# The stock emulator ramdisk has no such file; root-live.py ships it through
# Magisk's overlay.d, which magiskinit copies into the rootfs before init runs.
# This is the only way to execute code as root on a Play-store AVD: adb root is
# refused (ro.debuggable=0) and the manager app's setup needs a boot partition.

# Probe: proves init parsed this file.
on init
    setprop vibely.rc.parsed 1

# Probe: proves init can exec a shell here at all.
on init
    exec -- /system/bin/sh -c 'setprop vibely.exec.probe 1'

on property:sys.boot_completed=1
    exec -- /system/bin/sh /vibely-boot-hook.sh
